<?xml version='1.0' encoding='UTF-8'?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
  <input>
    <net-file value="berlin.net.xml"/>
    <route-files value="electric/e_routes.rou.xml, electric/e_vehicles.rou.xml"/>
    <additional-files value="berlin_bus_stops.add.xml, electric/e_type.add.xml, electric/e_depots.add.xml, electric/e_stations.add.xml"/>
  </input>
  <!--<output>
    <output-prefix value="output/electric_bus_TIME_"/>
    <log value="console.log"/>
    <summary-output value="summary.xml"/>
    <statistic-output value="statistics.xml"/>
    <battery-output value="battery.parquet"/>
    <chargingstations-output value="chargingstations.parquet"/>
    <tripinfo-output value="tripinfo.parquet"/>
    <tripinfo-output.write-unfinished value="true"/>
    <stop-output value="stopinfo.parquet"/>
  </output>-->
  <output>
    <output-prefix value="output/electric_bus_TIME_"/>
    <log value="console.log"/>
    <summary-output value="summary.xml"/>
    <statistic-output value="statistics.xml"/>
    <battery-output value="battery.xml"/>
    <chargingstations-output value="chargingstations.xml"/>
    <fcd-output value="fcdinfo.xml"/>
    <tripinfo-output value="tripinfo.xml"/>
    <tripinfo-output.write-unfinished value="true"/>
    <stop-output value="stopinfo.xml"/>
  </output>
  <time>
    <begin value="0.0"/>
    <end value="86400.0"/>
  </time>
  <processing>
    <route-steps value="200"/>
    <no-internal-links value="false"/>
    <ignore-junction-blocker value="20"/>
    <time-to-teleport value="-500.0"/>
    <time-to-teleport.highways value="0"/>
    <eager-insert value="false"/>
  </processing>
  <random_number>
    <random value="false"/>
    <seed value="251920"/>
  </random_number>
</configuration>
