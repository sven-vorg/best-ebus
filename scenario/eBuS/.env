# Configuration file for the eBuS Simulation

# Simulate a specific day between 2022 and 2023
## Affects pv generation values
## Affects electricity price
## WIP: Affects constant power intake -> if hot or cold power intake is higher for cooling or heating
date = 31.07.2022

# Integrated Energy Hub Specifications
## Set energy storage capacity in kWh: int
energy_storage = 500
## Cost per kWh of energy storage in €: float
cost_pkwh = 
## Solar Specifications
## Peak Power Output per Panel in W: int
peak_power = 500
## Number of Panels per Station: int
nr_panels = 4
## Costs per Panel in €: float
cost_pp = 1450.60

# Electricity Pricing
## Set electricity consumtion class accoarding to yearly consumption in MWh/year: int
## See https://genesis.destatis.de/datenbank/online/statistic/61243/table/61243-0006
consumption_class = 160000